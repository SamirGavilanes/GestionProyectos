@page "/"
@inject IJSRuntime JSRuntime
@inject ISecurityEngine securityEngine
@inject AuthenticationStateProvider authenticationProvider
@inject NavigationManager navigationManager

@using GestionProyectos.Engine.Security
@using GestionProyectos.Engine.Security.Request
@using GestionProyectos.Server.Extensions
@using GestionProyectos.Shared.Enums

@layout LoginLayout

<div class="relative flex min-h-screen items-center justify-center overflow-hidden bg-gradient-to-br from-primary-900 via-primary-800 to-secondary-800 px-3 py-6">
    <div class="pointer-events-none absolute -left-24 -top-24 h-56 w-56 rounded-full bg-white/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-16 h-56 w-56 rounded-full bg-secondary-500/20 blur-3xl"></div>

    <div class="relative w-full max-w-xs">
        <div class="mb-4 text-center text-white">
            <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-lg bg-white/15 backdrop-blur">
                <LucideIcon Name="layout-dashboard" CssClass="h-5 w-5 text-white" />
            </div>
            <h1 class="text-xs font-bold tracking-tight">Gestión de Proyectos</h1>
            <p class="mt-0.5 text-xs text-primary-100">Grupo MAS</p>
        </div>

        <div class="rounded-lg border border-white/20 bg-white p-4 shadow-xl">
            <h2 class="mb-3 text-xs font-semibold text-gray-900">Iniciar sesión</h2>

            <div class="mb-2.5">
                <label class="@Tw.FormLabel">Correo electrónico</label>
                <div class="relative">
                    <span class="pointer-events-none absolute left-2 top-1/2 -translate-y-1/2 text-gray-400">
                        <LucideIcon Name="mail" CssClass="h-3.5 w-3.5" />
                    </span>
                    <input @bind="login.UserName" type="email" placeholder="usuario@empresa.com"
                           class="@($"{Tw.FormInput} pl-7")" />
                </div>
            </div>

            <div class="mb-3">
                <label class="@Tw.FormLabel">Contraseña</label>
                <div class="relative">
                    <span class="pointer-events-none absolute left-2 top-1/2 -translate-y-1/2 text-gray-400">
                        <LucideIcon Name="lock" CssClass="h-3.5 w-3.5" />
                    </span>
                    <input @bind="login.Password" type="password" placeholder="••••••••"
                           class="@($"{Tw.FormInput} pl-7")" />
                </div>
            </div>

            @if (loginFailed)
            {
                <div class="mb-2.5 flex items-start gap-1.5 rounded border border-red-200 bg-red-50 px-2 py-1.5 text-xs text-red-700">
                    <LucideIcon Name="alert-circle" CssClass="mt-0.5 h-3.5 w-3.5 shrink-0" />
                    <span>@MessageDictionary.GenericError.Description</span>
                </div>
            }

            @if (wrongCredentials)
            {
                <div class="mb-2.5 flex items-start gap-1.5 rounded border border-red-200 bg-red-50 px-2 py-1.5 text-xs text-red-700">
                    <LucideIcon Name="alert-circle" CssClass="mt-0.5 h-3.5 w-3.5 shrink-0" />
                    <span>@errorMessage</span>
                </div>
            }

            <button @onclick="LogIn" class="@($"{Tw.BtnPrimary} w-full")">
                <LucideIcon Name="log-in" CssClass="h-3.5 w-3.5" />
                Iniciar sesión
            </button>
        </div>

        <p class="mt-3 text-center text-xs text-primary-100/80">© @DateTime.Now.Year Grupo MAS</p>
    </div>
</div>

@code {
    private LoginRequest login = new();
    private bool loginFailed;
    private bool wrongCredentials;
    private string errorMessage = string.Empty;

    protected override async System.Threading.Tasks.Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("initLucideIcons");
    }

    private async System.Threading.Tasks.Task LogIn()
    {
        var loginResponse = securityEngine.Login(login);

        if (loginResponse.Success)
        {
            var authenticationExt = (AuthenticationExtension)authenticationProvider;
            var session = loginResponse.Data?.Session;
            if (session == null)
            {
                loginFailed = true;
                return;
            }
            await authenticationExt.UpdateAuthenticationState(session);
            navigationManager.NavigateTo("/index");
        }
        else if (loginResponse.Message.Code != MessageDictionary.GenericError.Code)
        {
            loginFailed = false;
            wrongCredentials = true;
            errorMessage = loginResponse.Message.Description;
        }
        else
        {
            loginFailed = true;
            wrongCredentials = false;
        }
    }
}
