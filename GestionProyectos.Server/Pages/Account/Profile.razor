@page "/profile"
@inject IUserManagementEngine userManagementEngine
@inject ISessionStorageService session
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@using Blazored.SessionStorage
@using GestionProyectos.Engine.Security.Users
@using GestionProyectos.Engine.Security.Utilities
@using GestionProyectos.Server.Extensions
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

@attribute [Authorize]

<AuthorizeView>
    <Authorized>
        <h1 class="@Tw.PageTitle mb-2">Editar perfil</h1>
        <p class="@Tw.PageSubtitle mb-3">Actualice su foto de perfil y su contraseña de acceso.</p>

        <section class="@($"{Tw.FormCard} max-w-2xl")">
            <h2 class="mb-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-gray-500">
                <LucideIcon Name="user-round" CssClass="h-3.5 w-3.5 text-primary-600" />
                Foto de perfil
            </h2>

            <div class="flex items-center gap-4">
                <div class="relative flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-full border border-gray-200 bg-gray-100">
                    @if (!string.IsNullOrWhiteSpace(avatarPreviewUrl))
                    {
                        <img src="@avatarPreviewUrl" alt="Vista previa del avatar" class="h-full w-full object-cover" />
                    }
                    else
                    {
                        <span class="text-xs font-bold uppercase text-primary-700">@UserDisplayHelper.GetInitials(userContext.Name)</span>
                    }
                </div>
                <div class="min-w-0">
                    <p class="text-xs font-semibold text-gray-900">@userContext.Name</p>
                    <p class="truncate text-xs text-gray-500">@userContext.Email</p>
                    <p class="text-xs text-gray-500">@userContext.Role</p>
                </div>
            </div>

            <div class="mt-4 space-y-2">
                <label class="@Tw.FormLabel">Imagen</label>
                <p class="text-xs text-gray-500">PNG, JPG, GIF, WEBP o BMP. Máximo 512 KB.</p>
                <InputFile OnChange="HandleFileChanged" accept="image/*" class="block text-xs" />
            </div>

            @if (!string.IsNullOrWhiteSpace(avatarError))
            {
                <div class="mt-3 rounded border border-red-200 bg-red-50 px-2 py-1.5 text-xs text-red-700">@avatarError</div>
            }
            @if (!string.IsNullOrWhiteSpace(avatarSuccess))
            {
                <div class="mt-3 rounded border border-green-200 bg-green-50 px-2 py-1.5 text-xs text-green-700">@avatarSuccess</div>
            }

            <div class="mt-4 flex flex-wrap gap-2">
                <button type="button" class="@Tw.BtnPrimary" @onclick="UploadAvatar" disabled="@(uploading || pendingFile == null)">
                    @(uploading ? "Guardando..." : "Guardar foto")
                </button>
                @if (hasStoredAvatar)
                {
                    <button type="button" class="@Tw.BtnOutline" @onclick="RemoveAvatar" disabled="@uploading">
                        Quitar foto
                    </button>
                }
            </div>

            <div class="my-6 border-t border-gray-200"></div>

            <h2 class="mb-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-gray-500">
                <LucideIcon Name="key-round" CssClass="h-3.5 w-3.5 text-primary-600" />
                Cambiar contraseña
            </h2>

            <div class="space-y-3">
                <div>
                    <label class="@Tw.FormLabel">Contraseña actual</label>
                    <input type="password" class="@PasswordInputClass(currentPasswordError)" @bind="currentPassword" autocomplete="current-password" />
                    <FormFieldError Message="@currentPasswordError" />
                </div>
                <div>
                    <label class="@Tw.FormLabel">Nueva contraseña</label>
                    <input type="password" class="@PasswordInputClass(newPasswordError)" @bind="newPassword" autocomplete="new-password" />
                    <FormFieldError Message="@newPasswordError" />
                </div>
                <div>
                    <label class="@Tw.FormLabel">Confirmar nueva contraseña</label>
                    <input type="password" class="@PasswordInputClass(confirmPasswordError)" @bind="confirmPassword" autocomplete="new-password" />
                    <FormFieldError Message="@confirmPasswordError" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(passwordError))
            {
                <div class="mt-3 rounded border border-red-200 bg-red-50 px-2 py-1.5 text-xs text-red-700">@passwordError</div>
            }
            @if (!string.IsNullOrWhiteSpace(passwordSuccess))
            {
                <div class="mt-3 rounded border border-green-200 bg-green-50 px-2 py-1.5 text-xs text-green-700">@passwordSuccess</div>
            }

            <div class="mt-4 flex flex-wrap gap-2">
                <button type="button" class="@Tw.BtnPrimary" @onclick="SubmitPasswordChange" disabled="@changingPassword">
                    @(changingPassword ? "Guardando..." : "Actualizar contraseña")
                </button>
            </div>
        </section>

        <div class="mt-4">
            <button type="button" class="@Tw.BtnOutline" @onclick="Cancel">Volver</button>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private Context userContext = new();
    private IBrowserFile? pendingFile;
    private string? avatarPreviewUrl;
    private bool hasStoredAvatar;
    private bool uploading;
    private string? avatarError;
    private string? avatarSuccess;

    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string? currentPasswordError;
    private string? newPasswordError;
    private string? confirmPasswordError;
    private string? passwordError;
    private string? passwordSuccess;
    private bool changingPassword;

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        userContext = await session!.GetStorage<Context>("session") ?? new();
        await LoadCurrentAvatarAsync();
    }

    protected override async System.Threading.Tasks.Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("initLucideIcons");
    }

    private static string PasswordInputClass(string? error) =>
        string.IsNullOrWhiteSpace(error) ? Tw.FormInput : Tw.FormInputError;

    private async System.Threading.Tasks.Task LoadCurrentAvatarAsync()
    {
        if (userContext.UserId <= 0)
            return;

        var response = userManagementEngine.GetAvatar(userContext.UserId, userContext);
        if (!response.Success || response.Data == null || !response.Data.HasAvatar)
        {
            hasStoredAvatar = false;
            if (pendingFile == null)
                avatarPreviewUrl = null;
            return;
        }

        hasStoredAvatar = true;
        if (pendingFile == null)
            avatarPreviewUrl = UserDisplayHelper.ToDataUrl(response.Data.File, response.Data.FileName);
    }

    private async System.Threading.Tasks.Task HandleFileChanged(InputFileChangeEventArgs e)
    {
        avatarError = avatarSuccess = null;
        pendingFile = e.File;

        if (pendingFile.Size > 512_000)
        {
            avatarError = "La imagen supera 512 KB.";
            pendingFile = null;
            return;
        }

        try
        {
            using var stream = pendingFile.OpenReadStream(maxAllowedSize: 512_000);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            avatarPreviewUrl = UserDisplayHelper.ToDataUrl(memory.ToArray(), pendingFile.Name);
        }
        catch (Exception ex)
        {
            avatarError = ex.Message;
            pendingFile = null;
        }
    }

    private async System.Threading.Tasks.Task UploadAvatar()
    {
        if (pendingFile == null || userContext.UserId <= 0)
            return;

        avatarError = avatarSuccess = null;
        uploading = true;

        try
        {
            await using var stream = pendingFile.OpenReadStream(maxAllowedSize: 512_000);
            var response = userManagementEngine.UploadAvatar(userContext.UserId, pendingFile.Name, stream, userContext);
            if (!response.Success)
            {
                avatarError = response.Message.Description;
                return;
            }

            avatarSuccess = "Foto de perfil actualizada.";
            pendingFile = null;
            hasStoredAvatar = true;
            await LoadCurrentAvatarAsync();
        }
        finally
        {
            uploading = false;
        }
    }

    private async System.Threading.Tasks.Task RemoveAvatar()
    {
        if (userContext.UserId <= 0)
            return;

        if (!await JSRuntime.InvokeAsync<bool>("confirm", "¿Quitar su foto de perfil?"))
            return;

        avatarError = avatarSuccess = null;
        uploading = true;

        try
        {
            var response = userManagementEngine.RemoveAvatar(userContext.UserId, userContext);
            if (!response.Success)
            {
                avatarError = response.Message.Description;
                return;
            }

            avatarSuccess = "Foto de perfil eliminada.";
            pendingFile = null;
            hasStoredAvatar = false;
            avatarPreviewUrl = null;
        }
        finally
        {
            uploading = false;
        }
    }

    private bool ValidatePasswordChange()
    {
        currentPasswordError = newPasswordError = confirmPasswordError = passwordError = passwordSuccess = null;
        var valid = true;

        if (string.IsNullOrWhiteSpace(currentPassword))
        {
            currentPasswordError = "Ingrese su contraseña actual.";
            valid = false;
        }
        if (string.IsNullOrWhiteSpace(newPassword))
        {
            newPasswordError = "Ingrese la nueva contraseña.";
            valid = false;
        }
        else if (newPassword.Length < 6)
        {
            newPasswordError = "La contraseña debe tener al menos 6 caracteres.";
            valid = false;
        }
        if (string.IsNullOrWhiteSpace(confirmPassword))
        {
            confirmPasswordError = "Confirme la nueva contraseña.";
            valid = false;
        }
        else if (newPassword != confirmPassword)
        {
            confirmPasswordError = "Las contraseñas no coinciden.";
            valid = false;
        }

        return valid;
    }

    private async System.Threading.Tasks.Task SubmitPasswordChange()
    {
        if (!ValidatePasswordChange())
            return;

        changingPassword = true;

        try
        {
            var response = userManagementEngine.ChangePassword(userContext.UserId, currentPassword, newPassword, userContext);
            if (!response.Success)
            {
                passwordError = response.Message.Description;
                return;
            }

            passwordSuccess = "Contraseña actualizada correctamente.";
            currentPassword = newPassword = confirmPassword = string.Empty;
        }
        finally
        {
            changingPassword = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/index");
}
