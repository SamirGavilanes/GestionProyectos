    private static string FormatHours(decimal hours) => hours.ToString("0.##");

    private static string FormatDeviation(double percent) => percent >= 0 ? $"+{percent:0.#}%" : $"{percent:0.#}%";

    private static string GetDeviationClass(double percent) => percent > 0 ? "text-red-600" : percent < 0 ? "text-emerald-600" : "text-gray-700";



    private static string GetWorkPeriodLabel(DashboardReadResponse data) =>
        data.WorkStartDate.Date == data.WorkEndDate.Date
            ? data.WorkStartDate.ToString("dd/MM/yyyy", EsCulture)
            : $"{data.WorkStartDate:dd/MM/yyyy} – {data.WorkEndDate:dd/MM/yyyy}";

    private static string GetWorkPeriodShortLabel(DashboardReadResponse data) =>
        data.WorkStartDate.Date == data.WorkEndDate.Date
            ? data.WorkStartDate.ToString("dd/MM", EsCulture)
            : $"{data.WorkStartDate:dd/MM} – {data.WorkEndDate:dd/MM}";

    private int GetActiveFilterCount()
    {
        var count = 0;
        if (projectFilter > 0) count++;
        if (DatePeriodHelper.IsFilterActive(datePreset, filterStartDate, filterEndDate)) count++;
        return count;
    }

    private async System.Threading.Tasks.Task ClearFilters()
    {
        projectFilter = 0;
        datePreset = DatePeriodHelper.DefaultPreset;
        DatePeriodHelper.ApplyPreset(datePreset, out filterStartDate, out filterEndDate);
        RefreshFacetOptions();
        await LoadDataAsync();
    }

    private async System.Threading.Tasks.Task RenderDashboardChartsAsync()
    {
        if (data == null) return;

        if (HasTaskChartData(data))
        {
            var taskPayload = BuildStatusChartPayload(GetTaskChartLegend(data));
            await JSRuntime.InvokeVoidAsync("renderDashboardStatusChart", taskChartCanvasRef, taskPayload, TaskChartKey);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("disposeDashboardStatusChart", TaskChartKey);
        }

        if (HasBugChartData(data))
        {
            var bugPayload = BuildStatusChartPayload(GetBugChartLegend(data));
            await JSRuntime.InvokeVoidAsync("renderDashboardStatusChart", bugChartCanvasRef, bugPayload, BugChartKey);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("disposeDashboardStatusChart", BugChartKey);
        }

        if (HasProjectsChartData(data))
        {
            var projectsPayload = BuildStatusChartPayload(GetProjectsChartLegend(data));
            await JSRuntime.InvokeVoidAsync("renderDashboardStatusChart", projectsGaugeCanvasRef, projectsPayload, ProjectsGaugeKey);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("disposeDashboardStatusChart", ProjectsGaugeKey);
        }
    }

    private static bool HasProjectsChartData(DashboardReadResponse data) =>
        data.WorkedProjects.Count > 0;

    private static readonly string[] ProjectChartColors =
    {
        "#7c3aed", "#8b5cf6", "#6366f1", "#4f46e5", "#0d9488", "#14b8a6", "#a855f7"
    };

    private static List<ChartLegendSlice> GetProjectsChartLegend(DashboardReadResponse data)
    {
        var totalHours = data.WorkedProjects.Sum(p => p.HoursInPeriod);
        return data.WorkedProjects
            .Select((project, index) =>
            {
                var percent = totalHours > 0
                    ? Math.Round((double)(project.HoursInPeriod / totalHours * 100m), 1)
                    : 0;
                return new ChartLegendSlice(
                    TruncateChartLabel(project.ProjectName),
                    ProjectChartColors[index % ProjectChartColors.Length],
                    (double)project.HoursInPeriod,
                    percent,
                    project.ProjectName);
            })
            .ToList();
    }

    private static string TruncateChartLabel(string text, int maxLength = 22) =>
        text.Length <= maxLength ? text : text[..(maxLength - 1)] + "…";

    private static string FormatPercent(double percent) =>
        percent.ToString("0.#", EsCulture) + "%";

    private static bool HasTaskChartData(DashboardReadResponse data) =>
        data.MyAssignedTasks.Count > 0;

    private static bool HasBugChartData(DashboardReadResponse data) =>
        data.MyAssignedBugs.Count > 0;

    private static List<ChartLegendSlice> GetTaskChartLegend(DashboardReadResponse data) =>
        data.MyAssignedTasks
            .GroupBy(t => new { t.StatusName, t.StatusBadgeColor })
            .OrderByDescending(g => g.Count())
            .Select(g => new ChartLegendSlice(
                g.Key.StatusName,
                MapBadgeColorToChart(g.Key.StatusBadgeColor),
                g.Count()))
            .ToList();

    private static List<ChartLegendSlice> GetBugChartLegend(DashboardReadResponse data) =>
        data.MyAssignedBugs
            .GroupBy(b => new { b.StatusName, b.StatusBadgeColor })
            .OrderByDescending(g => g.Count())
            .Select(g => new ChartLegendSlice(
                g.Key.StatusName,
                MapBadgeColorToChart(g.Key.StatusBadgeColor),
                g.Count()))
            .ToList();

    private static object BuildStatusChartPayload(IReadOnlyList<ChartLegendSlice> slices) => new
    {
        labels = slices.Select(s => s.Label).ToArray(),
        values = slices.Select(s => s.Value).ToArray(),
        colors = slices.Select(s => s.Color).ToArray()
    };

    private static string MapBadgeColorToChart(string badgeColor) => badgeColor.ToLowerInvariant() switch
    {
        "green" => "#22c55e",
        "blue" => "#3b82f6",
        "amber" => "#f59e0b",
        "red" => "#ef4444",
        "violet" => "#8b5cf6",
        "purple" => "#a855f7",
        "orange" => "#f97316",
        "emerald" => "#10b981",
        _ => "#9ca3af"
    };

    private sealed record ChartLegendSlice(string Label, string Color, double Value, double Percent = 0, string? FullLabel = null);



    private static string FormatTimeOffRange(DashboardTimeOffBannerItem item) =>

        item.StartDate.Date == item.EndDate.Date

            ? item.StartDate.ToString("dd/MM/yyyy")

            : $"{item.StartDate:dd/MM/yyyy}  {item.EndDate:dd/MM/yyyy}";



    private static string GetTimeOffBadgeClass(short type) =>

        StatusBadgeHelper.TableBadgeBase + "font-semibold " + type switch

        {

            1 => "bg-blue-100 text-blue-800",

            2 => "bg-amber-100 text-amber-800",

            _ => "bg-gray-100 text-gray-800"

        };



    public void Dispose()
    {
        refreshTimer?.Dispose();
        _ = JSRuntime.InvokeVoidAsync("disposeDashboardStatusChart");
    }

}


