        showDetailPanel = true;
    }

    private async System.Threading.Tasks.Task OnDetailPanelChanged(bool isOpen)
    {
        showDetailPanel = isOpen;
        if (!isOpen)
            detailBug = null;
        await System.Threading.Tasks.Task.CompletedTask;
    }

    private string GetDetailPanelTitle() => detailBug == null ? "Detalle del bug" : $"Bug #{detailBug.Id}";

    private string GetDetailPanelSubtitle() =>
        detailBug == null
            ? string.Empty
            : $"Req. #{detailBug.RequirementId} · {detailBug.Status}";

    private void OpenAssignFromDetail()
    {
        if (detailBug == null) return;
        var bug = detailBug;
        showDetailPanel = false;
        OpenAssignModal(bug);
    }

    private void StartEditFromDetail()
    {
        if (detailBug == null) return;
        var bug = detailBug;
        showDetailPanel = false;
        StartEdit(bug);
    }

    private async System.Threading.Tasks.Task DownloadBugAttachment(long attachmentId, string fileName)
    {
        var response = taskBugEngine.DownloadAttachment(new TaskBugDownloadRequest
        {
            AttachmentId = attachmentId,
            Context = context
        });

        if (!response.Success || response.Data == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", response.Message?.Description ?? "No se pudo descargar el archivo.");
            return;
        }

        var base64 = Convert.ToBase64String(response.Data.File);
        await JSRuntime.InvokeVoidAsync("descargarArchivo", fileName, base64);
    }

    private void GoToCreateBug() => NavigationManager.NavigateTo("/create-bug");

    private string GetAssignProjectLabel(TaskBugOverviewItem bug)
    {
        var projectId = GetBugProjectId(bug);
        if (projectId <= 0) return "—";
        return allProjects.FirstOrDefault(p => p.Id == projectId)?.Description ?? $"Proyecto #{projectId}";
    }

    private void OpenAssignModal(TaskBugOverviewItem bug)
    {
        if (!isAdminRole) return;
        assigningBug = bug;
        assignTaskId = 0;
        assignTaskSearch = string.Empty;
        showAssignTaskDropdown = false;
        assignError = null;
        assignTaskOptions = taskBugEngine
            .GetTasksForRequirement(bug.RequirementId, context)
            .Data?.Tasks ?? new();
        showAssignModal = true;
    }

    private void CloseAssignModal()
    {
        showAssignModal = false;
        assigningBug = null;
        assignTaskSearch = string.Empty;
        showAssignTaskDropdown = false;
        assignError = null;
    }

    private void ShowAssignTaskDropdown() => showAssignTaskDropdown = true;

    private async System.Threading.Tasks.Task HideAssignTaskDropdown()
    {
        await System.Threading.Tasks.Task.Delay(150);
        showAssignTaskDropdown = false;
    }

    private void OnAssignTaskSearchInput(ChangeEventArgs e)
    {
        assignTaskSearch = e.Value?.ToString() ?? string.Empty;
        assignTaskId = 0;
        showAssignTaskDropdown = true;
    }

    private IEnumerable<TaskBugTaskOption> GetFilteredAssignTasks()
    {
        if (string.IsNullOrWhiteSpace(assignTaskSearch))
            return assignTaskOptions;

        var term = assignTaskSearch.Trim();
        return assignTaskOptions.Where(t =>
            t.Id.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ||
            t.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            t.DeveloperName.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private void SelectAssignTask(TaskBugTaskOption task)
    {
        assignTaskId = task.Id;
        assignTaskSearch = $"#{task.Id} · {task.Description} ({task.DeveloperName})";
        showAssignTaskDropdown = false;
    }

    private async System.Threading.Tasks.Task ConfirmAssign()
    {
        if (!isAdminRole || assigningBug == null) return;
        assignError = null;

        if (assignTaskId <= 0)
        {
            assignError = "Seleccione una tarea.";
            return;
        }

        saving = true;
        var response = taskBugEngine.AssignBugToTask(new TaskBugAssignRequest
        {
            BugId = assigningBug.Id,
            TaskId = assignTaskId,
            Context = context
        });
        saving = false;

        if (!response.Success)
        {
            assignError = response.Message?.Description ?? "No se pudo asignar el bug.";
            return;
        }

        CloseAssignModal();
        LoadBugs();
    }

    private void StartEdit(TaskBugOverviewItem bug)
    {
        editingBug = bug;
        editBugDescription = bug.Description;
        editBugStatusId = bug.TaskBugStatusId;
        editBugFiles = new();
    }

    private void CancelEdit()
    {
        editingBug = null;
        editBugDescription = string.Empty;
        editBugFiles = new();
    }

    private void HandleEditBugFileChanged(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            if (file.Size <= 512000)
                editBugFiles.Add(file);
            else
                JSRuntime.InvokeVoidAsync("alert", "El archivo supera 512 KB.");
        }
    }

    private void RemoveEditBugFile(IBrowserFile file) => editBugFiles.Remove(file);

    private List<FileItem> BuildEditBugFiles() =>
        editBugFiles.Select(file => new FileItem
        {
            Name = file.Name,
            File = file.OpenReadStream(maxAllowedSize: 512000)
        }).ToList();

    private async System.Threading.Tasks.Task SaveBugEdit(TaskBugOverviewItem bug)
    {
        if (string.IsNullOrWhiteSpace(editBugDescription))
        {
            await JSRuntime.InvokeVoidAsync("alert", "La descripción no puede estar vacía.");
            return;
        }

        saving = true;
        var response = taskBugEngine.SaveBug(new TaskBugSaveRequest
        {
            Id = bug.Id,
            RequirementId = bug.RequirementId,
            TaskId = bug.TaskId,
            Description = editBugDescription,
            TaskBugStatusId = editBugStatusId,
            Files = BuildEditBugFiles(),
            Context = context
        });
        saving = false;

        if (!response.Success)
        {
            await JSRuntime.InvokeVoidAsync("alert", response.Message.Description);
            return;
        }

        CancelEdit();
        LoadBugs();
    }

    private async System.Threading.Tasks.Task DeleteBug(long bugId)
    {
        if (!perms.CanDelete) return;
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "¿Eliminar este reporte de bug?"))
            return;

        var response = taskBugEngine.DeleteBug(new TaskBugDeleteRequest
        {
            Id = bugId,
            Context = context
        });

        if (!response.Success)
        {
            await JSRuntime.InvokeVoidAsync("alert", response.Message.Description);
            return;
        }

        if (editingBug?.Id == bugId)
            CancelEdit();
        LoadBugs();
    }

    private static string GetScopeLabel(bool withinScope) => withinScope ? "Sí" : "No";

    private static string GetScopeBadgeClass(bool withinScope) =>
        StatusBadgeHelper.TableBadgeBase + "font-semibold " +
        (withinScope ? "bg-green-100 text-green-800" : "bg-amber-100 text-amber-800");

    private static string GetBugStatusColor(string status) => status switch
    {
        var s when s.Contains("cerrado", StringComparison.OrdinalIgnoreCase) => "green",
        var s when s.Contains("corregido", StringComparison.OrdinalIgnoreCase) => "blue",
        var s when s.Contains("revisión", StringComparison.OrdinalIgnoreCase) => "amber",
        _ => "red"
    };

    private string GetBugStatusBadgeColor(long statusId) =>
        bugStatuses.FirstOrDefault(s => s.Id == statusId)?.BadgeColor ?? "gray";
}
