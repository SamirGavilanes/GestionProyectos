        return "Presupuesto agotado";
    }

    private static HoursFeasibilityInfo GetHoursFeasibility(decimal timeEstimationHours, decimal totalHoursWorked, int progressPercent)
    {
        if (progressPercent >= 100)
        {
            return new HoursFeasibilityInfo(
                "Tarea completada",
                "No queda avance pendiente por cubrir.",
                "border-green-200 bg-green-50/70",
                "text-green-800",
                "check-circle",
                "bg-green-100",
                "text-green-700");
        }

        if (timeEstimationHours <= 0)
        {
            return new HoursFeasibilityInfo(
                "Sin estimación",
                "Defina horas estimadas para evaluar si el presupuesto alcanza para el avance restante.",
                "border-gray-200 bg-gray-50/80",
                "text-gray-700",
                "help-circle",
                "bg-gray-100",
                "text-gray-500");
        }

        var remainingProgress = 100 - progressPercent;
        var remainingHours = timeEstimationHours - totalHoursWorked;

        if (progressPercent <= 0)
        {
            if (totalHoursWorked > 0)
            {
                return new HoursFeasibilityInfo(
                    "Sin avance medible",
                    $"Hay {FormatPanelHours(totalHoursWorked)} registradas, pero el avance sigue en 0%. Registre avance para proyectar si alcanzan las horas.",
                    "border-amber-200 bg-amber-50/70",
                    "text-amber-800",
                    "alert-triangle",
                    "bg-amber-100",
                    "text-amber-700");
            }

            return new HoursFeasibilityInfo(
                "Presupuesto inicial",
                $"Quedan {FormatPanelHours(remainingHours)} disponibles para completar el 100% de la tarea.",
                "border-sky-200 bg-sky-50/70",
                "text-sky-800",
                "info",
                "bg-sky-100",
                "text-sky-700");
        }

        decimal projectedHoursNeeded;
        string projectionBasis;

        if (totalHoursWorked > 0)
        {
            projectedHoursNeeded = totalHoursWorked * remainingProgress / progressPercent;
            projectionBasis = "según el ritmo actual de horas y avance";
        }
        else
        {
            projectedHoursNeeded = timeEstimationHours * remainingProgress / 100m;
            projectionBasis = "según la estimación planificada";
        }

        if (remainingHours <= 0)
        {
            return new HoursFeasibilityInfo(
                "Presupuesto agotado",
                $"Para el {remainingProgress}% restante se proyectan ~{FormatPanelHours(projectedHoursNeeded)} ({projectionBasis}) y no quedan horas en el presupuesto.",
                "border-red-200 bg-red-50/70",
                "text-red-800",
                "x-circle",
                "bg-red-100",
                "text-red-700");
        }

        var margin = remainingHours - projectedHoursNeeded;
        var tightThreshold = Math.Max(0.5m, projectedHoursNeeded * 0.1m);

        if (margin < 0)
        {
            return new HoursFeasibilityInfo(
                "No alcanzan",
                $"Para el {remainingProgress}% restante se proyectan ~{FormatPanelHours(projectedHoursNeeded)} ({projectionBasis}); solo quedan {FormatPanelHours(remainingHours)} (faltan ~{FormatPanelHours(Math.Abs(margin))}).",
                "border-red-200 bg-red-50/70",
                "text-red-800",
                "x-circle",
                "bg-red-100",
                "text-red-700");
        }

        if (margin <= tightThreshold)
        {
            return new HoursFeasibilityInfo(
                "Alcanzan justo",
                $"Para el {remainingProgress}% restante se proyectan ~{FormatPanelHours(projectedHoursNeeded)} ({projectionBasis}); quedan {FormatPanelHours(remainingHours)} (margen ~{FormatPanelHours(margin)}).",
                "border-amber-200 bg-amber-50/70",
                "text-amber-800",
                "alert-triangle",
                "bg-amber-100",
                "text-amber-700");
        }

        return new HoursFeasibilityInfo(
            "Sí alcanzan",
            $"Para el {remainingProgress}% restante se proyectan ~{FormatPanelHours(projectedHoursNeeded)} ({projectionBasis}); quedan {FormatPanelHours(remainingHours)} (margen ~{FormatPanelHours(margin)}).",
            "border-green-200 bg-green-50/70",
            "text-green-800",
            "check-circle",
            "bg-green-100",
            "text-green-700");
    }

    private static string FormatPanelHours(decimal hours) =>
        $"{FormatProgressHours(hours)} h";

    private sealed record HoursFeasibilityInfo(
        string Title,
        string Detail,
        string BorderClass,
        string TitleClass,
        string IconName,
        string IconBgClass,
        string IconClass);
}
