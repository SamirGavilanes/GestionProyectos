    private async System.Threading.Tasks.Task OnTaskMoved(KanbanMoveEventArgs<TaskItem> args)
    {
        if (!perms.CanEdit || args.Item.TaskStatusId == args.NewStatusId) return;

        if (IsFinalizedStatus(args.NewStatusId) && !perms.CanFinalize)
        {
            await JSRuntime.InvokeVoidAsync("alert", "No tiene permiso para finalizar tareas.");
            return;
        }

        if (IsBlockStatus(args.NewStatusId))
        {
            pendingBlockTask = args.Item;
            pendingBlockStatusId = args.NewStatusId;
            blockModalTaskLabel = args.Item.TaskDescription;
            blockModalStatusLabel = kanbanColumns.FirstOrDefault(c => c.Id == args.NewStatusId)?.Title ?? "Bloqueo";
            blockReasonInput = string.Empty;
            showBlockModal = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await ApplyStatusChange(args.Item, args.NewStatusId, null);
    }

    private async System.Threading.Tasks.Task ConfirmBlockStatus()
    {
        if (pendingBlockTask == null) return;
        if (string.IsNullOrWhiteSpace(blockReasonInput))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Indique el motivo del bloqueo.");
            return;
        }

        await ApplyStatusChange(pendingBlockTask, pendingBlockStatusId, blockReasonInput.Trim());
        CloseBlockModal();
    }

