    private async System.Threading.Tasks.Task ConfirmGroupAssign()
    {
        if (!HasMultipleSelection) return;

        if (groupAssignUserId <= 0)
        {
            groupAssignError = "Seleccione un desarrollador.";
            return;
        }

        var tasksToAssign = filteredTasks.Where(t => selectedTaskIds.Contains(t.Id)).ToList();
        var failed = 0;
        string? lastError = null;

        foreach (var item in tasksToAssign)
        {
            var response = taksUpdateEngine.Execute(new TaskUpdateRequest
            {
                Id = item.Id,
                TicketId = item.TicketId,
                Description = item.TaskDescription,
                TimeEstimationHours = item.TimeEstimationHours,
                TaskStatusId = item.TaskStatusId,
                IsWithinOriginalScope = item.IsWithinOriginalScope,
                ScopeChangeReason = item.ScopeChangeReason,
                DevelopmentPhaseId = item.DevelopmentPhaseId,
                UserId = groupAssignUserId,
                Context = context
            });

            if (!response.Success)
            {
                failed++;
                lastError = response.Message?.Description;
            }
        }

        CloseGroupAssignModal();
        selectedTaskIds.Clear();
        LoadTasks();

        if (failed > 0)
        {
            var assigned = tasksToAssign.Count - failed;
            var message = assigned > 0
                ? $"Se asignaron {assigned} tarea(s), pero {failed} no se pudieron actualizar. {lastError}"
                : lastError ?? "No se pudieron asignar las tareas.";
            await JSRuntime.InvokeVoidAsync("alert", message);
        }
    }

