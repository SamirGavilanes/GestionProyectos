    }

    private async System.Threading.Tasks.Task ApplyStatusChange(TaskItem item, long newStatusId, string? statusReason)
    {
        var response = taksUpdateEngine.Execute(new TaskUpdateRequest
        {
            Id = item.Id,
            TicketId = item.TicketId,
            Description = item.TaskDescription,
            TimeEstimationHours = item.TimeEstimationHours,
            TaskStatusId = newStatusId,
            IsWithinOriginalScope = item.IsWithinOriginalScope,
            ScopeChangeReason = item.ScopeChangeReason,
            StatusChangeReason = statusReason,
            DevelopmentPhaseId = item.DevelopmentPhaseId,
            Context = context
        });

        if (!response.Success)
            await JSRuntime.InvokeVoidAsync("alert", response.Message.Description);
        else
            LoadTasks();
    }

    private bool IsBlockStatus(long statusId)
    {
        var label = taskStatuses.FirstOrDefault(s => s.Id == statusId)?.Description
            ?? kanbanColumns.FirstOrDefault(c => c.Id == statusId)?.Title;
        return TaskStatusHelper.RequiresBlockReason(label);
