    private decimal GetMaxDayProgress() => Math.Max(0, 100 - hoursModalCurrentProgress);

    private decimal GetProjectedProgress() =>
        Math.Min(100, hoursModalCurrentProgress + Math.Max(0, hoursModalDayProgress));

    private bool IsTaskProgressComplete() => hoursModalCurrentProgress >= 100;

    private void DecreaseMinutes()
    {
        if (IsTaskProgressComplete()) return;
        hoursModalMinutes = Math.Max(MinutesStep, NormalizeMinutes(hoursModalMinutes) - MinutesStep);
    }

    private void IncreaseMinutes()
    {
        if (IsTaskProgressComplete()) return;
        hoursModalMinutes = NormalizeMinutes(hoursModalMinutes) + MinutesStep;
    }

    private void DecreaseProgress()
    {
        if (!CanRegisterDayProgress()) return;
        hoursModalDayProgress = Math.Max(0, NormalizeProgress(hoursModalDayProgress) - ProgressStep);
    }

    private void IncreaseProgress()
    {
        if (!CanRegisterDayProgress()) return;
        hoursModalDayProgress = Math.Min(GetMaxDayProgress(), NormalizeProgress(hoursModalDayProgress) + ProgressStep);
    }

    private bool CanRegisterDayProgress() =>
        hoursPanelTask != null
        && !string.IsNullOrWhiteSpace(hoursPanelTask.UserName)
        && string.Equals(
            hoursPanelTask.UserName.Trim(),
            context.Name.Trim(),
            StringComparison.OrdinalIgnoreCase);

    private static int NormalizeMinutes(int minutes)
    {
        if (minutes <= 0)
            return 0;

        return (int)(Math.Round(minutes / (double)MinutesStep, MidpointRounding.AwayFromZero) * MinutesStep);
    }

    private static decimal NormalizeProgress(decimal progress)
    {
        if (progress <= 0)
            return 0;

        return Math.Round(progress / ProgressStep, MidpointRounding.AwayFromZero) * ProgressStep;
    }

    private string FormatHoursFromMinutes(int minutes) =>
        FormatProgressHours(minutes / 60m);

    private void SaveHours()
    {
        if (!perms.CanView) return;
        hoursModalError = null;

        if (IsTaskProgressComplete())
        {
            hoursModalError = "No se pueden registrar horas cuando la tarea está al 100% de avance.";
            return;
        }

        var minDate = GetHoursModalMinDate();
        var maxDate = GetHoursModalMaxDate();
        if (hoursModalDate.Date < minDate || hoursModalDate.Date > maxDate)
        {
            hoursModalError = "Seleccione una fecha dentro de los últimos 3 días.";
            return;
        }

        hoursModalMinutes = NormalizeMinutes(hoursModalMinutes);
        if (hoursModalMinutes < MinutesStep)
        {
            hoursModalError = $"Ingrese al menos {MinutesStep} minutos trabajados.";
            return;
        }

        if (hoursModalHourTypeId <= 0)
        {
            hoursModalError = "Seleccione un tipo de hora.";
            return;
        }

        hoursModalDayProgress = NormalizeProgress(hoursModalDayProgress);
        if (!CanRegisterDayProgress())
            hoursModalDayProgress = 0;
        else
        {
            if (hoursModalDayProgress > GetMaxDayProgress())
                hoursModalDayProgress = GetMaxDayProgress();

            if (hoursModalDayProgress < 0)
            {
                hoursModalError = "El avance del día no puede ser negativo.";
                return;
            }

            if (hoursModalCurrentProgress + hoursModalDayProgress > 100)
            {
                hoursModalError = $"El avance total no puede superar el 100 % (máximo {GetMaxDayProgress():0.#}% hoy).";
                return;
            }
        }

        var usedHours = hoursModalMinutes / 60m;
        var savedTaskId = hoursModalTaskId;

        var response = timeLogRegistrationEngine.Execute(new TimeLogRegistrationRequest
        {
            TaskId = hoursModalTaskId,
            ExecutionDate = hoursModalDate,
            UsedHours = usedHours,
            ProgressPercent = hoursModalDayProgress,
            HourTypeId = hoursModalHourTypeId,
            Context = context
        });

        if (!response.Success)
        {
            hoursModalError = string.IsNullOrWhiteSpace(response.Message?.Description)
                ? "No se pudieron registrar las horas."
                : response.Message.Description;
            return;
        }

        CloseHoursPanel();
        LoadTasks();

        if (showProgressPanel && progressPanelTask != null && progressPanelTask.Id == savedTaskId)
            LoadProgressPanel(savedTaskId);
    }

