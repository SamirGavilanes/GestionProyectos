@inject IJSRuntime JSRuntime

@using System.Globalization
@using GestionProyectos.Engine.Feature.Project.Detail.Response

@implements IAsyncDisposable

@if (Detail != null)
{
    <div class="space-y-2">
        @if (ShowHoursCards)
        {
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        <div class="rounded-lg border border-gray-200 bg-white p-2 shadow-sm border-t-2 border-t-primary-500">
            <div class="flex items-center gap-2">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded bg-primary-50 text-primary-600">
                    <LucideIcon Name="clock" CssClass="h-3 w-3" />
                </div>
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Horas</p>
            </div>
            <p class="mt-1 text-xs font-bold tabular-nums text-gray-900">@FormatHours(Detail.Summary.LoggedHours)</p>
            <p class="mt-0.5 text-xs leading-tight text-gray-500">
                <span class="font-medium text-gray-700">@FormatHours(Detail.Summary.EstimatedHours)</span> estimadas
                <span class="mx-0.5 text-gray-300">·</span>
                <span class="font-medium @(Detail.Summary.RemainingHours > 0 ? "text-gray-700" : Detail.Summary.RemainingHours < 0 ? "text-red-600" : "text-green-600")">
                    @(Detail.Summary.RemainingHours < 0 ? FormatHours(Math.Abs(Detail.Summary.RemainingHours)) + " exced." : FormatHours(Math.Abs(Detail.Summary.RemainingHours)))
                </span>
                pendientes planificadas
            </p>
            <div class="mt-1.5 flex items-center gap-1.5">
                <span class="shrink-0 text-xs text-gray-400">Avance</span>
                <div class="h-1 min-w-0 flex-1 overflow-hidden rounded-full bg-gray-100">
                    <div class="h-full rounded-full bg-primary-600 transition-all"
                         style="width: @(GetLoggedProgressPercent(Detail.Summary))%"></div>
                </div>
                <span class="shrink-0 text-xs font-semibold tabular-nums text-primary-700">@FormatPercent(Detail.Summary.LoggedPercent)</span>
            </div>
        </div>

        <div class="rounded-lg border border-gray-200 bg-white p-2 shadow-sm border-t-2 border-t-emerald-500">
            <div class="flex items-center gap-2">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded bg-emerald-50 text-emerald-600">
                    <LucideIcon Name="trending-up" CssClass="h-3 w-3" />
                </div>
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Desfase en horas (promedio)</p>
            </div>
            <p class="mt-1 text-xs font-bold tabular-nums leading-tight @GetVarianceClass(Detail.Summary.AverageHoursVariance)">
                @FormatVariance(Detail.Summary.AverageHoursVariance)
            </p>
            <p class="text-xs text-gray-500">
                @Detail.Summary.TasksNegativeVariance favorable · @Detail.Summary.TasksPositiveVariance desfavorable
            </p>
            <div class="mt-1.5 space-y-1">
                <div class="grid grid-cols-[4.5rem_minmax(0,1fr)_3rem_2.25rem] items-center gap-x-1.5 text-xs">
                    <span class="text-emerald-700">Fav. (−)</span>
                    <div class="h-1 overflow-hidden rounded-full bg-gray-100">
                        <div class="h-full rounded-full bg-emerald-500"
                             style="width: @(GetSharePercent(Detail.Summary.HoursNegativeVariance, Detail.Summary.HoursNegativeVariance + Detail.Summary.HoursPositiveVariance))%"></div>
                    </div>
                    <span class="text-right font-semibold tabular-nums text-emerald-700">@FormatHours(Detail.Summary.HoursNegativeVariance)</span>
                    <span class="text-right tabular-nums text-gray-400">@FormatPercent(Detail.Summary.HoursNegativeVariancePercent)</span>
                </div>
                <div class="grid grid-cols-[4.5rem_minmax(0,1fr)_3rem_2.25rem] items-center gap-x-1.5 text-xs">
                    <span class="text-red-700">Desf. (+)</span>
                    <div class="h-1 overflow-hidden rounded-full bg-gray-100">
                        <div class="h-full rounded-full bg-red-500"
                             style="width: @(GetSharePercent(Detail.Summary.HoursPositiveVariance, Detail.Summary.HoursNegativeVariance + Detail.Summary.HoursPositiveVariance))%"></div>
                    </div>
                    <span class="text-right font-semibold tabular-nums text-red-700">@FormatHours(Detail.Summary.HoursPositiveVariance)</span>
                    <span class="text-right tabular-nums text-gray-400">@FormatPercent(Detail.Summary.HoursPositiveVariancePercent)</span>
                </div>
            </div>
        </div>
        </div>
        }

        @if (ShowProgressCards)
        {
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        <div class="flex min-h-[15rem] flex-col rounded-lg border border-gray-200 bg-white p-3 shadow-sm border-t-2 border-t-violet-500">
            <div class="flex items-center gap-2">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded bg-violet-50 text-violet-600">
                    <LucideIcon Name="gauge" CssClass="h-3 w-3" />
                </div>
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Avance</p>
            </div>
            <div class="relative mx-auto mt-2 min-h-[8.5rem] w-full max-w-[14rem] flex-1">
                <canvas @ref="progressGaugeRef" aria-label="Avance del proyecto"></canvas>
                <div class="pointer-events-none absolute inset-x-0 bottom-1 text-center">
                    <span class="text-xl font-bold tabular-nums text-violet-700">@FormatPercent(Detail.Summary.ProgressPercent)</span>
                </div>
            </div>
            <div class="mt-2 grid grid-cols-2 gap-1.5">
                <div class="flex items-center justify-between gap-1 rounded border border-emerald-100 bg-emerald-50/60 px-1.5 py-1">
                    <span class="text-xs text-emerald-800">Adelantadas</span>
                    <span class="text-xs font-bold tabular-nums text-emerald-700">
                        @Detail.Summary.TasksAheadSchedule
                        <span class="font-normal text-emerald-600">(@FormatPercent(Detail.Summary.TasksAheadSchedulePercent))</span>
                    </span>
                </div>
                <div class="flex items-center justify-between gap-1 rounded border border-red-100 bg-red-50/60 px-1.5 py-1">
                    <span class="text-xs text-red-800">Demoradas</span>
                    <span class="text-xs font-bold tabular-nums text-red-700">
                        @Detail.Summary.TasksBehindSchedule
                        <span class="font-normal text-red-600">(@FormatPercent(Detail.Summary.TasksBehindSchedulePercent))</span>
                    </span>
                </div>
            </div>
        </div>

        <div class="flex min-h-[15rem] flex-col rounded-lg border border-gray-200 bg-white p-3 shadow-sm border-t-2 border-t-amber-500">
            <div class="flex items-start gap-2">
                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded bg-amber-50 text-amber-600">
                    <LucideIcon Name="list-checks" CssClass="h-3 w-3" />
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-0">
                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Estado de tareas</p>
                        @if (!string.IsNullOrWhiteSpace(PeriodLabel))
                        {
                            <p class="shrink-0 text-xs tabular-nums text-gray-400">@PeriodLabel</p>
                        }
                    </div>
                    <p class="text-xs font-bold tabular-nums text-gray-900">
                        @Detail.Summary.TotalTasks <span class="font-normal text-gray-500">tareas</span>
                    </p>
                </div>
            </div>
            @if (Detail.Summary.TotalTasks > 0)
            {
                <div class="mt-2 min-h-[11rem] flex-1">
                    <canvas @ref="taskStatusBarRef" aria-label="Distribución de tareas por estado"></canvas>
                </div>
            }
            else
            {
                <p class="mt-3 flex flex-1 items-center text-xs text-gray-500">Sin tareas en el período seleccionado.</p>
            }
        </div>
        </div>
        }
    </div>
}

@code {
    private const string ProgressGaugeKey = "project-detail-progress-gauge";
    private const string TaskStatusBarKey = "project-detail-task-status-bar";

    [Parameter] public ProjectDetailReadResponse? Detail { get; set; }
    [Parameter] public string? PeriodLabel { get; set; }
    [Parameter] public bool ShowHoursCards { get; set; } = true;
    [Parameter] public bool ShowProgressCards { get; set; } = true;

    private ElementReference progressGaugeRef;
    private ElementReference taskStatusBarRef;
    private bool pendingChartRender;
    private int renderedVersion = -1;
    private int dataVersion;

    protected override void OnParametersSet()
    {
        dataVersion++;
        pendingChartRender = true;
    }

    protected override async System.Threading.Tasks.Task OnAfterRenderAsync(bool firstRender)
    {
        if (!pendingChartRender || Detail == null || !ShowProgressCards)
            return;

        if (renderedVersion == dataVersion)
            return;

        pendingChartRender = false;
        renderedVersion = dataVersion;

        await JSRuntime.InvokeVoidAsync("renderProjectProgressGauge", progressGaugeRef, new
        {
            percent = (double)Detail.Summary.ProgressPercent
        }, ProgressGaugeKey);

        if (Detail.Summary.TotalTasks > 0)
        {
            var segments = GetTaskStatusSegments().ToList();
            await JSRuntime.InvokeVoidAsync("renderProjectTaskStatusBarChart", taskStatusBarRef, new
            {
                labels = segments.Select(s => s.Label).ToArray(),
                values = segments.Select(s => s.Count).ToArray(),
                colors = segments.Select(s => s.ChartColor).ToArray()
            }, TaskStatusBarKey);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("disposeProjectMetricsCharts", TaskStatusBarKey);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (ShowProgressCards)
            await JSRuntime.InvokeVoidAsync("disposeProjectMetricsCharts");
    }

    private static int GetLoggedProgressPercent(ProjectDetailSummary summary)
    {
        if (summary.EstimatedHours <= 0)
            return summary.LoggedHours > 0 ? 100 : 0;
        var percent = (double)(summary.LoggedHours / summary.EstimatedHours * 100m);
        return (int)Math.Min(100, Math.Max(0, Math.Round(percent)));
    }

    private static int GetSharePercent(decimal part, decimal total)
    {
        if (total <= 0) return 0;
        return (int)Math.Round((double)(part / total * 100m));
    }

    private static int GetSharePercent(int part, int total) => GetSharePercent((decimal)part, (decimal)total);

    private IEnumerable<TaskStatusSegment> GetTaskStatusSegments()
    {
        if (Detail == null) yield break;
        var counts = Detail.Summary.TaskStatusCounts;
        yield return new TaskStatusSegment("Pendiente", counts.Pending, "#9ca3af");
        yield return new TaskStatusSegment("En progreso", counts.InProgress, "#3b82f6");
        yield return new TaskStatusSegment("Finalizada", counts.Finished, "#10b981");
        yield return new TaskStatusSegment("Bloqueo interno", counts.InternalBlock, "#f59e0b");
        yield return new TaskStatusSegment("Bloqueo externo", counts.ExternalBlock, "#f97316");
    }

    private sealed record TaskStatusSegment(string Label, int Count, string ChartColor);

    private static string FormatHours(decimal hours) =>
        hours.ToString("0.##", CultureInfo.InvariantCulture) + " h";

    private static string FormatVariance(decimal variance)
    {
        if (variance == 0) return "0 h";
        var sign = variance > 0 ? "+" : "";
        return sign + variance.ToString("0.##", CultureInfo.InvariantCulture) + " h";
    }

    private static string FormatPercent(decimal value) =>
        value.ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private static string GetVarianceClass(decimal variance) => variance switch
    {
        > 0 => "text-red-600",
        < 0 => "text-green-600",
        _ => "text-gray-500"
    };
}
