@using GestionProyectos.Data.Entities.TaskManagement

<div class="space-y-1.5">
    @if (HourTypes.Count == 0)
    {
        <p class="rounded-md border border-amber-200 bg-amber-50 px-2 py-1.5 text-xs text-amber-800">
            No hay tipos de hora configurados. Configure el catálogo en Tipos de Hora.
        </p>
    }
    else
    {
        @foreach (var hourType in HourTypes.OrderBy(h => h.Order))
        {
            var isSelected = Value == hourType.Id;
            <label class="@($"flex cursor-pointer items-start gap-2 rounded-md border px-2 py-1.5 text-xs transition {(isSelected ? "border-primary-400 bg-primary-50 ring-1 ring-primary-300" : "border-gray-200 hover:border-gray-300")}")">
                <input type="radio"
                       class="mt-0.5 shrink-0 border-gray-300 text-primary-600 focus:ring-primary-500"
                       name="@InputName"
                       checked="@isSelected"
                       @onchange="() => SelectHourType(hourType.Id)" />
                <span class="min-w-0 flex-1">
                    <span class="inline-flex items-center gap-1.5">
                        <StatusBadge Label="@hourType.Description" Color="@hourType.BadgeColor" />
                    </span>
                    @if (!string.IsNullOrWhiteSpace(hourType.Scope))
                    {
                        <span class="mt-0.5 block text-xs leading-snug text-gray-500">@hourType.Scope</span>
                    }
                </span>
            </label>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<HourType> HourTypes { get; set; } = Array.Empty<HourType>();
    [Parameter] public long Value { get; set; }
    [Parameter] public EventCallback<long> ValueChanged { get; set; }
    [Parameter] public string InputName { get; set; } = "hourTypePicker";

    private async System.Threading.Tasks.Task SelectHourType(long id) =>
        await ValueChanged.InvokeAsync(id);
}
