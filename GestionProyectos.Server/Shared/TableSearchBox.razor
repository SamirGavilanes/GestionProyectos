<label class="inline-flex @(Compact ? "h-7 min-w-[9rem]" : "min-w-[14rem]") items-center gap-1 rounded-md border border-gray-200 bg-white @(Compact ? "px-1.5 py-0.5" : "px-2 py-1.5") shadow-sm">
    <LucideIcon Name="search" CssClass="h-3.5 w-3.5 shrink-0 text-gray-400" />
    <input type="text"
           class="w-full min-w-0 border-0 bg-transparent p-0 text-xs text-gray-800 placeholder:text-gray-400 focus:outline-none focus:ring-0"
           placeholder="@(Compact ? "Buscar..." : "Buscar en la tabla...")"
           value="@Value"
           @oninput="OnInput" />
</label>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Compact { get; set; }

    private async System.Threading.Tasks.Task OnInput(ChangeEventArgs e) =>
        await ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
}
